# Copy to .env and fill in. Real values never get committed (.gitignore covers .env).

# --- App ---
NODE_ENV=development
# development | staging | production. Staging also runs NODE_ENV=production, so this is what tells it
# apart from the live site: only production is indexable (staging/dev send noindex).
APP_ENV=development
PORT=3000
# Public origin, no trailing slash. Used for canonical URLs, the sitemap and Open Graph tags.
APP_BASE_URL=http://localhost:3000
# Proxy hops in front of the app (Nginx = 1). Defaults to 1 in production, 0 elsewhere.
TRUST_PROXY=
# true = every page answers 503 with a maintenance page (health check and static files stay up).
MAINTENANCE_MODE=false
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Signs CSRF tokens. At least 32 random characters; REQUIRED whenever NODE_ENV=production (staging and live).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Development and tests use a fixed value when this is empty.
APP_SECRET=

# --- Database (MySQL 8, native local install for dev — see CLAUDE.md) ---
DATABASE_URL=mysql://root:CHANGEME@127.0.0.1:3306/aeo_corner_dev
SHADOW_DATABASE_URL=mysql://root:CHANGEME@127.0.0.1:3306/aeo_corner_shadow
TEST_DATABASE_URL=mysql://root:CHANGEME@127.0.0.1:3306/aeo_corner_test
# Path to the managed database's CA certificate file (DigitalOcean provides one). With "?ssl-mode=REQUIRED"
# on DATABASE_URL, the connection then verifies the server instead of only encrypting.
DATABASE_CA_CERT=

# --- Redis: queues, rate limits and circuit breakers (MVP §7.8) ---
# Production: DigitalOcean Managed Redis, a rediss:// URL, eviction policy "noeviction" (BullMQ requires it).
# Locally any Redis 6.2+ works. If it is shared with another project, use a database number other than 0
# (redis://127.0.0.1:6379/14) so the two never mix; the code never flushes a database.
REDIS_URL=
# Tests only; never falls back to REDIS_URL. On localhost it must name a database other than 0.
TEST_REDIS_URL=
# Prefix for every Redis key and BullMQ queue, so staging and production can share one Redis if they must.
QUEUE_PREFIX=aeo
# Optional: a Slack incoming-webhook URL. Operational alerts (breaker tripped, spend cap hit) go there as
# well as to the log. Without it they are only logged.
ALERT_WEBHOOK_URL=

# --- Clerk: customer app (DATABASE_SCHEMA.md §10.1, ADR-0004) ---
# Sign-in and sign-up use Clerk's hosted Account Portal pages. Set both keys or neither. The live site
# needs a production instance (pk_live_ / sk_live_); local and staging can use a development instance.
# CLERK_WEBHOOK_SECRET is the signing secret of the endpoint <APP_BASE_URL>/webhooks/clerk
# (events: user.created, user.updated, user.deleted).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Only to override where visitors are sent; by default they are derived from the publishable key.
CLERK_SIGN_IN_URL=
CLERK_SIGN_UP_URL=

# --- Clerk: staff app (separate application, behind Cloudflare Access) ---
# Staff sign in at STAFF_HOST (default: admin.<host of APP_BASE_URL>), behind Cloudflare Access. In that Clerk
# app: invite-only sign-up, multi-factor required, 30-minute inactivity timeout. Staff are added with
# "npm run staff:invite". Cloudflare Access is mandatory except when APP_ENV=development.
CLERK_STAFF_SECRET_KEY=
CLERK_STAFF_PUBLISHABLE_KEY=
CLERK_STAFF_WEBHOOK_SECRET=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
STAFF_HOST=
# Where the staff second factor comes from: clerk (default, needs Clerk Pro) or cloudflare (ADR-0019).
# With cloudflare, Cloudflare Access must be set above and its email must match the staff member's.
STAFF_SECOND_FACTOR=clerk

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Pins the Stripe API version (e.g. 2026-09-30). Leave empty to use the account's own.
STRIPE_API_VERSION=

# --- bKash (a way to pay in Bangladeshi taka, ADR-0018) ---
# From the merchant's bKash "tokenized checkout" credentials. All four, or none. Set, plans are enforced and the plan
# screen takes payment through bKash instead of Stripe. Outside production the sandbox address is used; the live site
# uses bKash's live address (BKASH_BASE_URL overrides either).
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

# --- Resend (email) ---
# Without a key, emails (such as team invitations) are written to the server log instead of being sent.
# Required when NODE_ENV=production.
RESEND_API_KEY=
# Signs Resend's delivery, bounce and complaint webhooks (whsec_...). Without it those are refused.
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS="AEO Corner <hello@aeocorner.com>"
# Billing notices (trial ending, account closing, plan changes) send from EMAIL_BILL_ADDRESS, and support notices
# (such as "reconnect Google") from EMAIL_SUPPORT_ADDRESS. Same format as above; the domain must be verified in
# Resend. Left empty, those messages go from EMAIL_FROM_ADDRESS.
EMAIL_BILL_ADDRESS=
EMAIL_SUPPORT_ADDRESS=
# Where a customer's reply goes, on every email. Use a real mailbox (the sending subdomain usually has none),
# e.g. support@aeocorner.com on your webmail. Left empty, replies go to the From address.
EMAIL_REPLY_TO=

# --- Claude API (Anthropic) ---
# Reads every collected answer (src/llm). Without it, extraction jobs fail at once.
ANTHROPIC_API_KEY=
# Which model reads answers: opus55 (claude-opus-5-5, the default) or haiku45 (claude-haiku-4-5). Decision D4, ADR-0007.
EXTRACTION_MODEL=

# --- DigitalOcean Spaces (object storage for raw crawled pages, MVP §7.1 raw-first storage) ---
# A private bucket. Set key, secret, bucket and endpoint, or none: with none, a laptop writes to .data/spaces on
# disk, and production refuses to start the worker. The bucket may be shared with other apps: everything this app
# writes goes inside one directory, aeo-corner/<dev|staging|prod>/ (change it with DO_SPACES_PREFIX).
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# Optional: the region defaults to the first part of the endpoint (sgp1).
DO_SPACES_REGION=
# DO_SPACES_PREFIX=aeo-corner/dev/

# --- Answer-engine data providers (src/engines, ADR-0006) ---
# A provider without credentials is unavailable: its engines use their fallback or say "couldn't check".
# Try one with: npm run engines:try -- --engine perplexity "a question" (a real, paid call).
# DataForSEO (ChatGPT + Gemini): the API login and password from app.dataforseo.com/api-access, both or neither.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Perplexity Agent API. PERPLEXITY_MODEL defaults to perplexity/sonar (the old Sonar answer).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
# SerpApi (Google AI Overviews). The cost of one search on our plan (plan price / searches); default 0.010 (Production).
SERPAPI_API_KEY=
SERPAPI_COST_PER_SEARCH_USD=

# --- Google (GA4 + Search Console OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cloudflare Turnstile (free audit bot protection) ---
# The free audit opens only when the secret key is set (with the database and Redis); without it the form says the audit
# is not open yet. For local work use Cloudflare's published test pair, which always passes:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# What all free audits together may spend in one UTC day, in USD (one audit is about $0.60). Default 60.
AUDIT_DAILY_BUDGET_USD=

# --- Observability ---
SENTRY_DSN=
# PostHog runs cookieless on the public site (docs/UI_DESIGN.md §9). Also switch on "Cookieless server
# hash mode" in the PostHog project settings. Leave the key empty to load no analytics at all.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Only for a self-hosted or proxied PostHog; derived from POSTHOG_HOST otherwise.
POSTHOG_ASSETS_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Secrets envelope encryption (MVP §7.11 — kept apart from the repo/DB in prod) ---
ENCRYPTION_MASTER_KEY=

# --- Content Studio ---
# The model that researches, plans and writes drafts: opus55 (default) or haiku45.
CONTENT_MODEL=opus55

# --- Integration secrets (WordPress application passwords, later Google tokens) ---
# Envelope-encryption master key: 32 random bytes, base64. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of the database and the repo. Without it the WordPress screen says it is not set up (development uses a
# fixed key). To rotate: set the new key here with SECRETS_MASTER_KEY_VERSION one higher, and move the old key to
# SECRETS_MASTER_KEY_PREVIOUS until every secret is re-wrapped.
SECRETS_MASTER_KEY=
SECRETS_MASTER_KEY_VERSION=1
SECRETS_MASTER_KEY_PREVIOUS=
