# Copy to .env and fill in. Real values never get committed (.gitignore covers .env).

# --- App ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Database (MySQL 8, native local install for dev — see CLAUDE.md) ---
DATABASE_URL=mysql://root:CHANGEME@127.0.0.1:3306/aeo_corner_dev
SHADOW_DATABASE_URL=mysql://root:CHANGEME@127.0.0.1:3306/aeo_corner_shadow
TEST_DATABASE_URL=mysql://root:CHANGEME@127.0.0.1:3306/aeo_corner_test

# --- Redis (DigitalOcean-hosted, public URL — nothing to install locally) ---
REDIS_URL=

# --- Clerk: customer app (DATABASE_SCHEMA.md §10.1) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# --- Clerk: staff app (separate application, behind Cloudflare Access) ---
CLERK_STAFF_SECRET_KEY=
CLERK_STAFF_PUBLISHABLE_KEY=
CLERK_STAFF_WEBHOOK_SECRET=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=

# --- DigitalOcean Spaces (object storage) ---
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=

# --- Answer-engine data providers ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=

# --- Google (GA4 + Search Console OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cloudflare Turnstile (free audit bot protection) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Secrets envelope encryption (MVP §7.11 — kept apart from the repo/DB in prod) ---
ENCRYPTION_MASTER_KEY=
