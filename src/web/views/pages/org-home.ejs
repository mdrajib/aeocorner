<%# The empty authenticated shell for one organization. Real screens (projects, dashboard) arrive from Phase 8. %>
<h1 class="text-3xl"><%= org.name %></h1>
<p class="text-ink-700 mt-2">You’re signed in as <strong><%= roleLabel %></strong>.</p>
<div class="mt-6">
  <%- ui.state({ kind: 'empty', title: 'No projects yet', text: 'A project tracks one brand’s website across AI answer engines. You’ll be able to create your first one here soon.' }) %>
</div>
<% if (can('members.manage')) { %>
<p class="text-ink-700 mt-6 text-sm">Meanwhile, you can <a href="<%= orgBase %>/settings">invite your team</a>.</p>
<% } %>
