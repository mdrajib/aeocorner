<%# C4: the sources the AI cites. Props: total, rows, gaps, urls, types, trend, sites, questions, ownPages, ownCitations, never, scanned, tab,
    ranges, updatedLabel, stale, lastRun, actionsHref; locals: orgBase, projectBase, projectName, domain. %>
<%- ui.fragment('partials/dashboard-top', { orgBase, projectBase, projectName, domain, current: 'citations', ranges, updatedLabel, stale, lastRun }) %>

<% if (!total) { %>
<div class="mt-6"><%- ui.state({ kind: 'empty', title: 'No sources were cited in this period', text: 'Engines such as Perplexity and Google AI Overviews show their sources. They appear here after a check that has them.', action: { label: 'Open the overview', href: projectBase } }) %></div>
<% } else { %>
<p class="text-ink-700 mt-4 max-w-3xl text-sm">These are the websites the AI engines cited in their answers to your questions: <%= total %> citations in this period. Being named on the sites AI trusts is one of the strongest ways to be named by it.</p>

<div class="mt-6">
  <%- ui.tabs({ id: 'citations', label: 'Citation views', initial: tab, tabs: [
    { id: 'overview', label: 'Overview', html: ui.fragment('partials/citations-overview', { total, rows, gaps, types, trend }) },
    { id: 'opportunities', label: 'Opportunities', html: ui.fragment('partials/citations-opportunities', { sites, questions, actionsHref, projectBase }) },
    { id: 'pages', label: 'Your pages', html: ui.fragment('partials/citations-pages', { ownPages, ownCitations, never, scanned, urls }) },
  ] }) %>
</div>
<% } %>
