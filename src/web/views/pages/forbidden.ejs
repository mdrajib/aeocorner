<%# 403 inside the app shell: signed in, a member of the organization, but the role doesn't allow this page. %>
<div class="mx-auto max-w-xl py-12 text-center">
  <p class="eyebrow">Error 403</p>
  <h1 class="mt-3 text-3xl">You don’t have access to this page</h1>
  <p class="text-ink-700 mt-3">Your role (<%= typeof roleLabel !== 'undefined' ? roleLabel : 'member' %>) doesn’t include it. An owner or admin of the organization can change your role if you need it.</p>
  <div class="mt-6"><%- ui.button({ label: 'Back to the overview', href: typeof orgBase !== 'undefined' ? orgBase : '/app' }) %></div>
</div>
