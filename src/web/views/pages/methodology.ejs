  ['principles', 'Principles'],
  ['engines', 'Engines and how we collect answers'],
  ['sampling', 'Sampling and statistics'],
  ['sample-sizes', 'Sample sizes'],
  ['extraction', 'Reading the answers'],
  ['metrics', 'What we measure'],
  ['score', 'The AI Visibility Score'],
  ['readiness', 'The AEO Readiness checklist'],
  ['audit-score', 'The free audit’s AEO Score'],
  ['proof', 'How we judge a fix'],
  ['limits', 'Known limits'],
  ['never', 'What we will not do'],
  ['references', 'References'],
