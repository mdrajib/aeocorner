<%# The free tools hub (Milestone 17): one card per tool that is live. Every tool is free and needs no account. %>
<div class="bg-ink-50 border-ink-200 border-b py-12 sm:py-16">
  <div class="container-narrow">
    <p class="eyebrow">Free tools</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Free tools for AI search</h1>
    <p class="text-ink-700 mt-3 text-lg">Each tool is free, needs no account, and says plainly what it cannot tell you.</p>
  </div>
</div>

<section class="py-12" aria-labelledby="tools-heading">
  <div class="container-narrow">
    <h2 class="text-2xl" id="tools-heading">Choose a tool</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      <% for (const t of tools) { %>
      <li class="card card-body">
        <h3 class="text-lg tracking-normal"><a href="/tools/<%= t.slug %>"><%= t.name %></a></h3>
        <p class="text-ink-700 mt-2 text-sm leading-6"><%= t.lead %></p>
        <p class="mt-3"><%- ui.badge({ text: t.badge, tone: 'neutral' }) %></p>
      </li>
      <% } %>
    </ul>
    <p class="text-ink-700 mt-8 text-sm leading-6">Each tool looks at one file or one page at a time. To find out whether ChatGPT, Perplexity, Gemini and Google AI Overviews actually name your brand, run the <a href="/?utm_source=tools&amp;utm_campaign=hub#audit">free AEO audit</a>.</p>
  </div>
</section>
