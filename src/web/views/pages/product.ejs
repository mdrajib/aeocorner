<%
// One template for the four product pages. `stage` is an entry of src/web/content/product.js; `stages` is the list, for the stepper.
const nextStage = stage.next ? stages.find((s) => s.slug === stage.next) : null;
-%>
<section class="hero" aria-labelledby="product-heading">
  <div class="container-page grid gap-12 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-20">
    <div>
      <p class="eyebrow">Step <%= stage.step %> of 4 · <%= stage.name %></p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:leading-[1.05]" id="product-heading"><%= stage.h1 %></h1>
      <p class="text-ink-200 mt-5 max-w-xl text-lg"><%= stage.lead %></p>
    </div>
    <div class="card text-ink-900 max-w-xl">
      <div class="card-body">
        <h2 class="text-lg tracking-normal">Start with the free audit</h2>
        <p class="text-ink-700 mt-1 mb-4 text-sm">Real answers from four AI engines, your score and your top five fixes. No account needed.</p>
        <%- ui.auditForm({ idPrefix: 'hero', variant: 'compact', utm }) %>
      </div>
    </div>
  </div>
</section>

<nav aria-label="The four stages" class="border-ink-200 border-b bg-white">
  <ol class="container-page flex flex-wrap gap-x-6 gap-y-1 py-3 text-sm">
    <% for (const s of stages) { %>
    <li><a class="nav-link" href="/product/<%= s.slug %>"<% if (s.slug === stage.slug) { %> aria-current="page"<% } %>><span class="tabular-nums"><%= s.step %>.</span> <%= s.name %></a></li>
    <% } %>
  </ol>
</nav>

<% stage.sections.forEach((section, index) => { %>
<section class="<%= index % 2 === 0 ? 'py-16 sm:py-20' : 'bg-ink-50 border-ink-200 border-y py-16 sm:py-20' %>" aria-labelledby="section-<%= index %>">
  <div class="container-page">
    <h2 class="max-w-2xl text-3xl sm:text-4xl" id="section-<%= index %>"><%= section.heading %></h2>
    <p class="text-ink-700 mt-3 max-w-2xl text-lg"><%= section.intro %></p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      <% for (const [title, text] of section.items) { %>
      <li class="card card-body">
        <h3 class="text-lg"><%= title %></h3>
        <p class="text-ink-700 mt-2 text-sm leading-6"><%= text %></p>
      </li>
      <% } %>
    </ul>
  </div>
</section>
<% }) %>

<section class="py-16 sm:py-20" id="faq" aria-labelledby="faq-heading">
  <div class="container-narrow">
    <p class="eyebrow">FAQ</p>
    <h2 class="mt-2 text-3xl sm:text-4xl" id="faq-heading">Questions about <%= stage.name.toLowerCase() %></h2>
    <%- include('../partials/faq-list') %>
    <p class="mt-10 flex flex-wrap gap-3">
      <% if (nextStage) { %><%- ui.button({ label: 'Next: ' + nextStage.name, href: '/product/' + nextStage.slug, variant: 'secondary', iconRight: 'arrow-right' }) %><% } %>
      <%- ui.button({ label: 'See pricing', href: '/pricing', variant: 'secondary' }) %>
      <%- ui.button({ label: 'Read the methodology', href: '/methodology', variant: 'secondary' }) %>
    </p>
  </div>
</section>
