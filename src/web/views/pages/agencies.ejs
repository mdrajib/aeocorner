<section class="hero" aria-labelledby="agency-heading">
  <div class="container-page grid gap-12 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-20">
    <div>
      <p class="eyebrow">For agencies</p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:leading-[1.05]" id="agency-heading"><%= page.h1 %></h1>
      <p class="text-ink-200 mt-5 max-w-xl text-lg"><%= page.lead %></p>
    </div>
    <div class="card text-ink-900 max-w-xl">
      <div class="card-body">
        <h2 class="text-lg tracking-normal">Audit a prospect or a client now</h2>
        <p class="text-ink-700 mt-1 mb-4 text-sm">Enter their website. Add a competitor to show the gap.</p>
        <%- ui.auditForm({ idPrefix: 'hero', variant: 'compact', utm }) %>
      </div>
    </div>
  </div>
</section>

<% page.sections.forEach((section, index) => { %>
<section class="<%= index % 2 === 0 ? 'py-16 sm:py-20' : 'bg-ink-50 border-ink-200 border-y py-16 sm:py-20' %>" aria-labelledby="section-<%= index %>">
  <div class="container-page">
    <h2 class="max-w-2xl text-3xl sm:text-4xl" id="section-<%= index %>"><%= section.heading %></h2>
    <p class="text-ink-700 mt-3 max-w-2xl text-lg"><%= section.intro %></p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      <% for (const [title, text] of section.items) { %>
      <li class="card card-body">
        <h3 class="text-lg"><%= title %></h3>
        <p class="text-ink-700 mt-2 text-sm leading-6"><%= text %></p>
      </li>
      <% } %>
    </ul>
  </div>
</section>
<% }) %>

<section class="py-16 sm:py-20" id="faq" aria-labelledby="faq-heading">
  <div class="container-narrow">
    <p class="eyebrow">FAQ</p>
    <h2 class="mt-2 text-3xl sm:text-4xl" id="faq-heading">Questions from agencies</h2>
    <%- include('../partials/faq-list') %>
    <p class="mt-10"><%- ui.button({ label: 'See the Agency plan', href: '/pricing', variant: 'secondary', iconRight: 'arrow-right' }) %></p>
  </div>
</section>
