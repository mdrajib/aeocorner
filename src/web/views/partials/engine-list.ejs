<%# The engines a project is checked on. Props: engines ([{ engine_code, enabled, notTracked, allowed }]), names; optional: canEdit, projectBase, csrfToken (editors get switches). An engine the project was never offered is "Not tracked", not "Off"; one the plan does not include cannot be switched on. %>
<% if (locals.canEdit) { %>
<form method="post" action="<%= projectBase %>/engines" class="flex flex-col gap-3" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <fieldset class="flex flex-col gap-1">
    <legend class="sr-only">AI engines we check</legend>
    <% for (const e of engines) { %>
    <% const locked = e.allowed === false && !e.enabled; %>
    <%- ui.checkbox({ id: 'engine-' + e.engine_code, name: 'engine', value: e.engine_code, label: (names[e.engine_code] || e.engine_code) + (locked ? ' (not in your plan)' : e.notTracked ? ' (not tracked yet)' : ''), checked: e.enabled, disabled: locked }) %>
    <% } %>
  </fieldset>
  <p class="text-ink-600 text-sm">At least one engine stays on. Each one you add is asked every question, every week.</p>
  <div><%- ui.button({ label: 'Save engines', type: 'submit', variant: 'secondary', size: 'sm' }) %></div>
</form>
<% } else { %>
<ul class="divide-ink-200 divide-y">
  <% for (const e of engines) { %>
  <li class="flex items-center justify-between gap-3 py-2">
    <span><%= names[e.engine_code] || e.engine_code %></span>
    <%- ui.badge({ text: e.enabled ? 'On' : (e.notTracked ? 'Not tracked' : 'Off'), tone: e.enabled ? 'success' : 'neutral' }) %>
  </li>
  <% } %>
</ul>
<% } %>
