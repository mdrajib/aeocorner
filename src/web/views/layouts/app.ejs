<%#
  Authenticated app shell: sidebar + top bar + content.
  Locals: nav ([{ href, label, icon, current }]), user ({ name }), org ({ publicId, name }), orgs ([{ publicId, name }]),
  csrfToken, project ({ name }), flash ([{ tone, text }]), refreshSeconds (optional: reload the page every so many seconds).
%><!doctype html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body class="bg-ink-50">
  <a class="skip-link" href="#main">Skip to main content</a>
  <div class="flex min-h-screen flex-col lg:flex-row">
    <aside class="app-sidebar lg:min-h-screen" aria-label="Sidebar">
      <div class="mb-4 px-1"><%- ui.logo({ tone: 'light', href: '/app' }) %></div>
      <nav aria-label="App" class="flex flex-row flex-wrap gap-1 lg:flex-col">
        <% for (const item of (typeof nav !== 'undefined' ? nav : [])) { %>
        <a class="app-nav-link" href="<%= item.href %>"<% if (item.current) { %> aria-current="page"<% } %>><%- ui.icon({ name: item.icon || 'list', size: 18 }) %><%= item.label %></a>
        <% } %>
      </nav>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-ink-200 flex min-h-16 flex-wrap items-center justify-between gap-3 border-b bg-white px-4 py-2 sm:px-6">
        <%# Organization switcher: a native <details> disclosure, so it works without JavaScript. %>
        <% if (typeof org !== 'undefined' && org) { %>
        <details class="relative">
          <summary class="btn btn-secondary btn-sm list-none" aria-label="Organization: <%= org.name %>. Switch organization"><%- ui.icon({ name: 'globe', size: 16 }) %><span class="max-w-48 truncate"><%= org.name %></span></summary>
          <nav aria-label="Your organizations" class="border-ink-200 shadow-pop absolute left-0 z-20 mt-2 flex w-72 flex-col gap-1 rounded-xl border bg-white p-2">
            <% for (const o of (typeof orgs !== 'undefined' ? orgs : [])) { %>
            <a class="nav-link truncate" href="/app/o/<%= o.publicId %>"<% if (o.publicId === org.publicId) { %> aria-current="page"<% } %>><%= o.name %></a>
            <% } %>
            <a class="nav-link" href="/app/new-org">+ Create another organization</a>
          </nav>
        </details>
        <% } else { %><p class="text-ink-700 text-sm font-semibold"><%= typeof project !== 'undefined' && project ? project.name : 'AEO Corner' %></p><% } %>
        <% if (typeof user !== 'undefined' && user) { %>
        <div class="flex items-center gap-3">
          <p class="text-ink-700 max-w-56 truncate text-sm"><%= user.name %></p>
          <% if (typeof csrfToken !== 'undefined') { %>
          <form method="post" action="/sign-out">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%- ui.button({ label: 'Sign out', type: 'submit', variant: 'ghost', size: 'sm' }) %>
          </form>
          <% } %>
        </div>
        <% } %>
      </header>
      <main id="main" tabindex="-1" class="flex-1 p-4 sm:p-6 lg:p-8">
        <% for (const f of (typeof flash !== 'undefined' ? flash : [])) { %><div class="mb-4"><%- ui.banner({ tone: f.tone, text: f.text, dismissible: true }) %></div><% } %>
<%# A page that waits for a job (res.locals.refreshSeconds) reloads itself; the visitor can stop it (components.js). %>
        <% if (typeof refreshSeconds !== 'undefined' && refreshSeconds) { %>
        <div class="text-ink-700 mb-4 flex flex-wrap items-center gap-3 text-sm" data-auto-refresh="<%= refreshSeconds %>">
          <span data-auto-refresh-text>This page updates by itself.</span>
          <%- ui.button({ label: 'Stop updating', variant: 'ghost', size: 'sm', attrs: { 'data-auto-refresh-stop': '' } }) %>
        </div>
        <% } %>
<%- body %>
      </main>
    </div>
  </div>
  <div class="toast-region" data-toast-region role="status" aria-live="polite"></div>
<%- include('../partials/scripts') %>
</body>
</html>
