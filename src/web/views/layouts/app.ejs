<%#
  Authenticated app shell: sidebar + top bar + content. Empty until Phase 2 fills it.
  Locals: nav ([{ href, label, icon, current }]), pageTitle, user ({ name }), project ({ name }), flash ([{ tone, text }]).
%><!doctype html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body class="bg-ink-50">
  <a class="skip-link" href="#main">Skip to main content</a>
  <div class="flex min-h-screen flex-col lg:flex-row">
    <aside class="app-sidebar lg:min-h-screen" aria-label="Sidebar">
      <div class="mb-4 px-1"><%- ui.logo({ tone: 'light', href: '/app' }) %></div>
      <nav aria-label="App" class="flex flex-row flex-wrap gap-1 lg:flex-col">
        <% for (const item of (typeof nav !== 'undefined' ? nav : [])) { %>
        <a class="app-nav-link" href="<%= item.href %>"<% if (item.current) { %> aria-current="page"<% } %>><%- ui.icon({ name: item.icon || 'list', size: 18 }) %><%= item.label %></a>
        <% } %>
      </nav>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-ink-200 flex h-16 items-center justify-between gap-4 border-b bg-white px-4 sm:px-6">
        <p class="text-ink-700 text-sm font-semibold"><%= typeof project !== 'undefined' && project ? project.name : 'No project yet' %></p>
        <p class="text-ink-700 text-sm"><%= typeof user !== 'undefined' && user ? user.name : 'Signed out' %></p>
      </header>
      <main id="main" tabindex="-1" class="flex-1 p-4 sm:p-6 lg:p-8">
        <% for (const f of (typeof flash !== 'undefined' ? flash : [])) { %><div class="mb-4"><%- ui.banner({ tone: f.tone, text: f.text, dismissible: true }) %></div><% } %>
<%- body %>
      </main>
    </div>
  </div>
  <div class="toast-region" data-toast-region role="status" aria-live="polite"></div>
<%- include('../partials/scripts') %>
</body>
</html>
