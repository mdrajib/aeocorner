<%#
  Shared HTML wrapper for every transactional email. Table layout + inline styles because email clients
  ignore <style> blocks and CSS variables. Colours come from `t` (src/lib/email-tokens.js).
  Locals: preheader, bodyHtml (trusted, from the content template), baseUrl, footerReason, unsubscribeUrl.
%><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>AEO Corner</title>
</head>
<body style="margin:0;padding:0;background-color:<%= t['ink-50'] %>;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;"><%= preheader %></div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= t['ink-50'] %>;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
        <tr>
          <td style="padding:0 0 20px 4px;font-family:Arial,Helvetica,sans-serif;font-size:20px;font-weight:700;color:<%= t['ink-950'] %>;">
            <span style="display:inline-block;width:12px;height:12px;background-color:<%= t['signal-400'] %>;border-radius:6px;margin-right:8px;"></span>AEO Corner
          </td>
        </tr>
        <tr>
          <td style="background-color:#ffffff;border:1px solid <%= t['ink-200'] %>;border-top:4px solid <%= t['brand-600'] %>;border-radius:8px;padding:32px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;color:<%= t['ink-900'] %>;">
            <%- bodyHtml %>
          </td>
        </tr>
        <tr>
          <td style="padding:20px 4px 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:<%= t['ink-600'] %>;">
            <p style="margin:0 0 8px 0;"><%= footerReason %></p>
            <% if (unsubscribeUrl) { %><p style="margin:0 0 8px 0;"><a href="<%= unsubscribeUrl %>" style="color:<%= t['brand-700'] %>;">Unsubscribe</a></p><% } %>
            <p style="margin:0;">AEO Corner · <a href="<%= baseUrl %>" style="color:<%= t['brand-700'] %>;"><%= baseUrl.replace(/^https?:\/\//, '') %></a></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
