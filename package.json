{
  "name": "aeo-corner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEO Corner — measure, diagnose, fix and prove brand visibility in AI answer engines.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/web/server.js",
    "worker": "node --watch src/worker/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --test \"src/**/*.test.js\"",
    "test:routes": "node --test \"tests/routes/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:tenancy": "node --test \"tests/tenancy/**/*.test.js\"",
    "test:adapters": "node --test \"tests/adapters/**/*.test.js\"",
    "test:smoke": "node --test tests/smoke.test.js",
    "test:journey": "node --test --test-timeout=300000 \"tests/journey/**/*.test.js\"",
    "test:wordpress": "node --test --test-timeout=300000 \"tests/wordpress/**/*.test.js\"",
    "test:security": "node --test --test-timeout=300000 \"src/crawler/ip-guard.test.js\" \"src/crawler/safe-fetch.test.js\" \"src/lib/url.test.js\" \"src/lib/secrets.test.js\" \"src/lib/tool-runner.test.js\" \"tests/integration/tool-limits.test.js\" \"src/core/tool-findings.test.js\" \"tests/routes/tools.test.js\" \"tests/routes/tools-robots.test.js\" \"tests/routes/tools-structured-data.test.js\" \"tests/routes/tools-sitemap.test.js\" \"tests/routes/tools-robots-generator.test.js\" \"tests/routes/tools-schema-generator.test.js\" \"tests/routes/tools-llms-generator.test.js\" \"tests/routes/tools-security.test.js\" \"src/core/permissions.test.js\" \"src/web/auth/*.test.js\" \"src/web/middleware/security.test.js\" \"src/integrations/stripe.test.js\" \"tests/integration/crawler-fetch.test.js\" \"tests/integration/domain-verifier.test.js\" \"tests/integration/secrets-audit.test.js\" \"tests/adapters/render.test.js\" \"tests/adapters/wordpress.test.js\" \"tests/routes/app.test.js\" \"tests/routes/security.test.js\" \"tests/routes/staff*.test.js\" \"tests/routes/webhooks.test.js\" \"tests/routes/webhook-audit.test.js\" \"tests/tenancy/**/*.test.js\"",
    "test:all": "npm run test && npm run test:smoke && npm run test:routes && npm run test:integration && npm run test:tenancy && npm run test:adapters && npm run test:journey",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "build:css": "tailwindcss -i ./tailwind/input.css -o ./src/web/public/build/app.css --minify",
    "watch:css": "tailwindcss -i ./tailwind/input.css -o ./src/web/public/build/app.css --watch",
    "vendor": "node scripts/vendor.js && node scripts/build-editor.js",
    "build:editor": "node scripts/build-editor.js",
    "staff:invite": "node scripts/staff-invite.js",
    "scan": "node scripts/scan-site.js",
    "engines:try": "node scripts/engine-try.js",
    "golden:collect": "node scripts/golden-collect.js",
    "golden:review": "node scripts/golden-review.js",
    "eval:extraction": "node scripts/eval-extraction.js",
    "eval:narrative": "node scripts/eval-narrative.js",
    "cost:report": "node scripts/cost-report.js",
    "load:audits": "node scripts/load-audits.js",
    "start": "node src/web/server.js",
    "stripe:sync": "node scripts/stripe-sync-plans.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@bull-board/api": "^9.10.2",
    "@bull-board/express": "^9.10.2",
    "@clerk/express": "^2.1.75",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.11",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "mariadb": "^3.4.7",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "alpinejs": "^3.17.4",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "htmx.org": "^2.0.11",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3"
  }
}
