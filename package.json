{
  "name": "aeo-corner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEO Corner — measure, diagnose, fix and prove brand visibility in AI answer engines.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/web/server.js",
    "worker": "node --watch src/worker/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --test \"src/**/*.test.js\"",
    "test:routes": "node --test \"tests/routes/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:tenancy": "node --test \"tests/tenancy/**/*.test.js\"",
    "test:adapters": "node --test \"tests/adapters/**/*.test.js\"",
    "test:smoke": "node --test tests/smoke.test.js",
    "test:all": "npm run test && npm run test:smoke && npm run test:routes && npm run test:integration && npm run test:tenancy && npm run test:adapters",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "build:css": "tailwindcss -i ./tailwind/input.css -o ./src/web/public/build/app.css --minify",
    "watch:css": "tailwindcss -i ./tailwind/input.css -o ./src/web/public/build/app.css --watch",
    "vendor": "node scripts/vendor.js",
    "staff:invite": "node scripts/staff-invite.js",
    "start": "node src/web/server.js"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/express": "^9.10.2",
    "@clerk/express": "^2.1.75",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "mariadb": "^3.4.7",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.17.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "htmx.org": "^2.0.11",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3"
  }
}
