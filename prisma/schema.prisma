model action_outcomes {
  id                BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  org_id            BigInt                  @db.UnsignedBigInt
  project_id        BigInt                  @db.UnsignedBigInt
  recommendation_id BigInt                  @db.UnsignedBigInt
  horizon           action_outcomes_horizon
  engine_scope      String                  @default("all") @db.VarChar(32)
  prompts_count     Int                     @db.UnsignedSmallInt
  baseline_run_ids  Json
  after_run_ids     Json
